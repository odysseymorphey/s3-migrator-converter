SPACES_KEY=your_spaces_access_key
SPACES_SECRET=your_spaces_secret_key
SPACES_REGION=fra1
SOURCE_BUCKET=source-bucket
DEST_BUCKET=

# Optional settings
# Leave DEST_BUCKET empty to use SOURCE_BUCKET.
SOURCE_PREFIX=/folder
DEST_PREFIX=/folder-webp
SPACES_ENDPOINT=
WEBP_QUALITY=80
WEBP_LOSSLESS=false
WEBP_EXACT=true
CONCURRENCY=8
SKIP_EXISTING=true
DRY_RUN=false
CACHE_CONTROL=public, max-age=3600, s-max-age=86400
PUBLIC_READ=true
